    {
      "name": "5. Transfers",
      "item": [
        {
          "name": "Reject transfer without CSRF token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "no-csrf-{{transferKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/transfers",
            "description": "No X-XSRF-TOKEN header, so Spring Security blocks the request before it reaches the controller.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"{{bobMobile}}\",\n  \"amount\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// The collection script adds the CSRF header to every write request;",
                  "// remove it here because this request tests what happens without it.",
                  "pm.request.headers.remove(\"X-XSRF-TOKEN\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject transfer without Idempotency-Key",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"{{bobMobile}}\",\n  \"amount\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 400 INVALID_IDEMPOTENCY_KEY\", () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error).to.eql(\"INVALID_IDEMPOTENCY_KEY\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Send 250.50 to Bob (by mobile number)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{transferKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/transfers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"{{bobMobile}}\",\n  \"amount\": 250.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 200 with both balances\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    const t = pm.response.json();",
