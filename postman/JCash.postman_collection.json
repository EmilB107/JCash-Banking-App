                  "    pm.expect(history.totalElements).to.eql(2);",
                  "    pm.expect(history.content).to.have.length(2);",
                  "});",
                  "pm.test(\"newest entry is the transfer debit\", () => {",
                  "    const [debit, cashIn] = history.content;",
                  "    pm.expect(debit.transactionType).to.eql(\"TRANSFER\");",
                  "    pm.expect(debit.direction).to.eql(\"DEBIT\");",
                  "    pm.expect(Number(debit.amount)).to.eql(250.5);",
                  "    pm.expect(Number(debit.balanceAfter)).to.eql(749.5);",
                  "    pm.expect(debit.details).to.include(\"Transfer to Bob Reyes\");",
                  "    pm.expect(debit.transferReference).to.be.a(\"string\");",
                  "    pm.expect(cashIn.transactionType).to.eql(\"CASH_IN\");",
                  "    pm.expect(cashIn.transferReference).to.eql(null);",
                  "    pm.collectionVariables.set(\"transferReference\", debit.transferReference);",
                  "});"
