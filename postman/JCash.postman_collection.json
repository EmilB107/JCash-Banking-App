{
  "info": {
    "name": "JCash Banking API",
    "description": "End-to-end walkthrough of the JCash API. Run the whole collection in order\n(Collection Runner or `npx newman run`): later requests use variables and the\nsession cookie saved by earlier ones.\n\nEach run registers fresh users (Alice, Bob, and Carol) with unique emails and\nmobile numbers, so it can be repeated against the same database.\n\nSet the `baseUrl` collection variable to point at another server.\nAll money is simulated; no real funds are involved.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Runs before every request, so the headers below aren't repeated on each one.",
          "// Write requests (POST, PUT, ...) must send the CSRF token Spring Security expects.",
          "if (pm.request.method !== \"GET\") {",
          "    pm.request.headers.upsert({ key: \"X-XSRF-TOKEN\", value: pm.collectionVariables.get(\"csrfToken\") });",
          "}",
          "// Requests with a JSON body tell the server it's JSON.",
          "if (pm.request.body && pm.request.body.mode === \"raw\") {",
          "    pm.request.headers.upsert({ key: \"Content-Type\", value: \"application/json\" });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const runId = Date.now();",
                  "const mobile = () => \"09\" + String(Math.floor(Math.random() * 1e9)).padStart(9, \"0\");",
                  "pm.collectionVariables.set(\"aliceEmail\", `alice.${runId}@example.com`);",
                  "pm.collectionVariables.set(\"bobEmail\", `bob.${runId}@example.com`);",
                  "pm.collectionVariables.set(\"carolEmail\", `carol.${runId}@example.com`);",
                  "pm.collectionVariables.set(\"aliceMobile\", mobile());",
                  "pm.collectionVariables.set(\"bobMobile\", mobile());",
                  "pm.collectionVariables.set(\"carolMobile\", mobile());",
                  "pm.collectionVariables.set(\"alicePin\", \"123456\");",
                  "pm.collectionVariables.set(\"aliceNewPin\", \"246810\");",
                  "pm.collectionVariables.set(\"bobPin\", \"654321\");",
                  "pm.collectionVariables.set(\"transferKey\", `transfer-${runId}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 200 UP\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(\"UP\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get CSRF token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 200 with a CSRF token\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"csrfToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Registration",
      "item": [
        {
          "name": "Register Alice",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{aliceEmail}}\",\n  \"mobileNumber\": \"{{aliceMobile}}\",\n  \"displayName\": \"Alice Santos\",\n  \"pin\": \"{{alicePin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 201 with the new user\", () => {",
                  "    pm.response.to.have.status(201);",
                  "    const user = pm.response.json();",
                  "    pm.expect(user.email).to.eql(pm.collectionVariables.get(\"aliceEmail\"));",
                  "    pm.expect(user.mobileNumber).to.eql(pm.collectionVariables.get(\"aliceMobile\"));",
                  "    pm.expect(user).to.not.have.property(\"pin\");",
                  "    pm.expect(user).to.not.have.property(\"pinHash\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Bob (mixed-case email, +63 mobile)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users",
            "description": "Shows normalization: the email is lowercased and +639... is stored as 09....",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bobEmailMixedCase}}\",\n  \"mobileNumber\": \"{{bobMobileIntl}}\",\n  \"displayName\": \"Bob Reyes\",\n  \"pin\": \"{{bobPin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = pm.collectionVariables.get(\"bobEmail\");",
                  "pm.variables.set(\"bobEmailMixedCase\", email.charAt(0).toUpperCase() + email.slice(1));",
                  "pm.variables.set(\"bobMobileIntl\", \"+63\" + pm.collectionVariables.get(\"bobMobile\").slice(1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 201 with normalized email and mobile number\", () => {",
                  "    pm.response.to.have.status(201);",
                  "    const user = pm.response.json();",
                  "    pm.expect(user.email).to.eql(pm.collectionVariables.get(\"bobEmail\"));",
                  "    pm.expect(user.mobileNumber).to.eql(pm.collectionVariables.get(\"bobMobile\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Carol (lockout demo)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{carolEmail}}\",\n  \"mobileNumber\": \"{{carolMobile}}\",\n  \"displayName\": \"Carol Cruz\",\n  \"pin\": \"111111\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject duplicate email",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{aliceEmail}}\",\n  \"mobileNumber\": \"09000000000\",\n  \"displayName\": \"Copycat\",\n  \"pin\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 409 EMAIL_ALREADY_REGISTERED\", () => {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().error).to.eql(\"EMAIL_ALREADY_REGISTERED\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject duplicate mobile number",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{unusedEmail}}\",\n  \"mobileNumber\": \"{{aliceMobile}}\",\n  \"displayName\": \"Copycat\",\n  \"pin\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set(\"unusedEmail\", `nobody.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 409 MOBILE_NUMBER_ALREADY_REGISTERED\", () => {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().error).to.eql(\"MOBILE_NUMBER_ALREADY_REGISTERED\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid fields",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"mobileNumber\": \"12345\",\n  \"displayName\": \"\",\n  \"pin\": \"12ab\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 400 VALIDATION_FAILED\", () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error).to.eql(\"VALIDATION_FAILED\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Authentication",
      "item": [
        {
          "name": "Reject protected endpoint without a session",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject wrong PIN",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{bobEmail}}\",\n  \"pin\": \"000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 401 INVALID_CREDENTIALS\", () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error).to.eql(\"INVALID_CREDENTIALS\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject unknown user with the same error",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Same 401 as a wrong PIN, so the API does not reveal which emails or mobile numbers are registered.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"nobody@example.com\",\n  \"pin\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 401 INVALID_CREDENTIALS\", () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error).to.eql(\"INVALID_CREDENTIALS\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Carol: wrong PIN 1 of 3",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{carolEmail}}\",\n  \"pin\": \"000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 401 INVALID_CREDENTIALS\", () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error).to.eql(\"INVALID_CREDENTIALS\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Carol: wrong PIN 2 of 3",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{carolEmail}}\",\n  \"pin\": \"000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 401 INVALID_CREDENTIALS\", () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error).to.eql(\"INVALID_CREDENTIALS\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Carol: wrong PIN 3 of 3 locks the account",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{carolEmail}}\",\n  \"pin\": \"000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 423 ACCOUNT_LOCKED\", () => {",
                  "    pm.response.to.have.status(423);",
                  "    pm.expect(pm.response.json().error).to.eql(\"ACCOUNT_LOCKED\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Carol: correct PIN still rejected while locked",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{carolEmail}}\",\n  \"pin\": \"111111\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 423 ACCOUNT_LOCKED\", () => {",
                  "    pm.response.to.have.status(423);",
                  "    pm.expect(pm.response.json().error).to.eql(\"ACCOUNT_LOCKED\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as Alice (by mobile number)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{aliceMobile}}\",\n  \"pin\": \"{{alicePin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 200 Login successful\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().message).to.eql(\"Login successful\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh CSRF token after login",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns 200 with a CSRF token\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"csrfToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns Alice's profile\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"aliceEmail\"));",
                  "    pm.expect(pm.response.json().displayName).to.eql(\"Alice Santos\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Cash-in",
      "item": [
        {
          "name": "Get account (starts at zero)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"returns a PHP account with a zero balance\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    const account = pm.response.json();",
                  "    pm.expect(account.currency).to.eql(\"PHP\");",
                  "    pm.expect(Number(account.balance)).to.eql(0);",
                  "});",
                  "pm.collectionVariables.set(\"aliceAccountId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cash in 1,000.00",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/accounts/me/cash-in",
